        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; --- Styling &amp; Engine Configurations ---\nhide circle\nskinparam linetype ortho\nskinparam roundcorner 5\nskinparam shadowing false\nskinparam classBorderColor #2C3E50\nskinparam classBackgroundColor #FFFFFF\nskinparam classHeaderBackgroundColor #EAECEE\nskinparam arrowColor #2C3E50\nskinparam arrowThickness 1.5\n\n&#39; Color coding for Key badges\n&lt;style&gt;\nclassDiagram {\n  class {\n    header {\n      FontStyle bold\n    }\n  }\n}\n&lt;/style&gt;\n\n&#39; ========================================================\n&#39; LEGEND / NOTATION KEY\n&#39; ========================================================\nlegend top left\n  |= Key &amp; Notation Symbol |= Description |\n  | &lt;back:#D4EFDF&gt; **&lt;color:#196F3D&gt;  PK  &lt;/color&gt;** &lt;/back&gt; | **Primary Key**: Uniquely identifies each record |\n  | &lt;back:#FCF3CF&gt; **&lt;color:#B7950B&gt;  FK  &lt;/color&gt;** &lt;/back&gt; | **Foreign Key**: References a PK in parent table |\n  | **`*`** (asterisk) | Mandatory field (NOT NULL) |\n  | **`||--|{`** | **One-to-Many relationship**: Exactly 1 (parent) to 1 or more (children) |\nendlegend\n\n&#39; ========================================================\n&#39; ENTITIES (TABLES)\n&#39; ========================================================\n\nentity \&quot;categories\&quot; as categories {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; category_id : INTEGER\n  --\n  * category_name : VARCHAR(100)\n  description : TEXT\n}\n\nentity \&quot;suppliers\&quot; as suppliers {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; supplier_id : INTEGER\n  --\n  * supplier_name : VARCHAR(150)\n  phone : VARCHAR(20)\n  city : VARCHAR(50)\n}\n\nentity \&quot;warehouses\&quot; as warehouses {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; warehouse_id : INTEGER\n  --\n  * warehouse_name : VARCHAR(100)\n  city : VARCHAR(50)\n}\n\nentity \&quot;branches\&quot; as branches {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; branch_id : INTEGER\n  --\n  * branch_name : VARCHAR(100)\n  city : VARCHAR(50)\n}\n\nentity \&quot;products\&quot; as products {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; product_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; category_id : INTEGER\n  * product_name : VARCHAR(200)\n  unit : VARCHAR(20)\n  unit_price : DECIMAL(10,2)\n  reorder_level : INTEGER\n}\n\nentity \&quot;employees\&quot; as employees {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; employee_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; branch_id : INTEGER\n  first_name : VARCHAR(100)\n  last_name : VARCHAR(100)\n  role : VARCHAR(50)\n}\n\nentity \&quot;inventory\&quot; as inventory {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; inventory_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; product_id : INTEGER\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; branch_id : INTEGER\n  quantity : INTEGER\n}\n\nentity \&quot;purchase_orders\&quot; as purchase_orders {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; purchase_order_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; supplier_id : INTEGER\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; warehouse_id : INTEGER\n  order_date : DATE\n  status : VARCHAR(20)\n}\n\nentity \&quot;purchase_order_lines\&quot; as purchase_order_lines {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; purchase_order_line_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; purchase_order_id : INTEGER\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; product_id : INTEGER\n  quantity : INTEGER\n  unit_cost : DECIMAL(10,2)\n}\n\nentity \&quot;sales_transactions\&quot; as sales_transactions {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; sale_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; branch_id : INTEGER\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; employee_id : INTEGER\n  sale_date : DATE\n}\n\nentity \&quot;sales_transaction_lines\&quot; as sales_transaction_lines {\n  * &lt;back:#D4EFDF&gt;&lt;color:#196F3D&gt;**PK**&lt;/color&gt;&lt;/back&gt; sale_line_id : INTEGER\n  --\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; sale_id : INTEGER\n  * &lt;back:#FCF3CF&gt;&lt;color:#B7950B&gt;**FK**&lt;/color&gt;&lt;/back&gt; product_id : INTEGER\n  quantity : INTEGER\n  unit_price : DECIMAL(10,2)\n}\n\n&#39; ========================================================\n&#39; RELATIONSHIPS (Crow&#39;s Foot 1-to-Many: ||--|{)\n&#39; ========================================================\ncategories ||--|{ products : \&quot;1:N\&quot;\nbranches ||--|{ employees : \&quot;1:N\&quot;\nbranches ||--|{ inventory : \&quot;1:N\&quot;\nbranches ||--|{ sales_transactions : \&quot;1:N\&quot;\nproducts ||--|{ inventory : \&quot;1:N\&quot;\nproducts ||--|{ purchase_order_lines : \&quot;1:N\&quot;\nproducts ||--|{ sales_transaction_lines : \&quot;1:N\&quot;\nsuppliers ||--|{ purchase_orders : \&quot;1:N\&quot;\nwarehouses ||--|{ purchase_orders : \&quot;1:N\&quot;\npurchase_orders ||--|{ purchase_order_lines : \&quot;1:N\&quot;\nemployees ||--|{ sales_transactions : \&quot;1:N\&quot;\nsales_transactions ||--|{ sales_transaction_lines : \&quot;1:N\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wxmAzBvtoh1uS9ZSEHJQ-1">
